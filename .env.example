# Nebius Token Factory API key. Used for both LLM inference and sandboxes.
NEBIUS_API_KEY=

# Base URL of the Nebius Token Factory Sandbox API.
NEBIUS_SANDBOX_API_URL=https://api.studio.nebius.com/v1/sandboxes

# Tavily key for the Principal Investigator's hardware research. Without it,
# the cell's default limits are used and the dashboard says so.
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------

# Execution backend for the physics guardrail:
#   local  - run the harness in an isolated subprocess on this machine (default, no API key needed, good for development and for proving the loop)
#   nebius - run the harness inside an ephemeral Nebius sandbox
CREPIDINEM_SANDBOX_BACKEND=local

# Container image used when the nebius backend creates a sandbox.
CREPIDINEM_SANDBOX_IMAGE=python:3.12-slim

# Wall-clock seconds a single sandbox execution may take before it is killed.
CREPIDINEM_EXEC_TIMEOUT=30

# Seconds to wait on any single Nebius HTTP call.
CREPIDINEM_HTTP_TIMEOUT=60

# DEBUG | INFO | WARNING | ERROR
CREPIDINEM_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# agents
# ---------------------------------------------------------------------------

# OpenAI-compatible inference endpoint for Token Factory.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Model routing: Ultra for serious reasoning, Nano for the fast everyday calls.
CREPIDINEM_PLANNER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
CREPIDINEM_CODER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Completion budgets. These are reasoning models: the budget covers thinking tokens too, so a small ceiling yields an empty answer.
CREPIDINEM_PLANNER_MAX_TOKENS=4096
CREPIDINEM_CODER_MAX_TOKENS=4096

# Seconds to wait on one inference call.
CREPIDINEM_LLM_TIMEOUT=300

# Brief the Code Smith with the cell's numeric limits.
CREPIDINEM_BRIEF_LIMITS=true

# ---------------------------------------------------------------------------
#hardware research
# ---------------------------------------------------------------------------

# Look up the published limits of the hardware named in the goal, and enforce those instead of the cell
CREPIDINEM_RESEARCH=true

# How far a retrieved value may move an enforced limit:
#   narrow-only - retrieved text may tighten a safety limit, never loosen one
#   envelope    - loosening is allowed inside a hard-coded plausible range, and only when the value is quoted from the cited document
CREPIDINEM_RESEARCH_TRUST=envelope

# Search results to request per query.
CREPIDINEM_RESEARCH_MAX_RESULTS=5

CREPIDINEM_RESEARCH_CACHE=true

# Re-issue every query live
CREPIDINEM_RESEARCH_REFRESH=false

# How long a stored search stays usable
CREPIDINEM_RESEARCH_CACHE_TTL_HOURS=336

